{
  "name": "orkest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:supabase": "set -a && . ./.env.supabase && set +a && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "prisma dev --name orkest --detach",
    "db:stop": "prisma dev stop orkest",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push && tsx prisma/seed.ts",
    "db:push:supabase": "node --env-file=.env.supabase node_modules/prisma/build/index.js db push",
    "postinstall": "prisma generate",
    "test:flows": "tsx scripts/test-phase1.ts && tsx scripts/test-phase2.ts && tsx scripts/test-phase3.ts && tsx scripts/test-warehouses.ts && tsx scripts/test-inventory-audit.ts",
    "check:seed": "tsx scripts/check-seed.ts",
    "test:crawl": "DB_POOL_MAX=1 tsx scripts/crawl.ts",
    "import:odoo": "tsx --env-file=.env --env-file=.env.odoo scripts/odoo/import.ts",
    "import:odoo:supabase": "tsx --env-file=.env.supabase --env-file=.env.odoo scripts/odoo/import.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.6",
    "jose": "^6.2.12",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
